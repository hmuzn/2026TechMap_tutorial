@Tutorial(time: 40) {
    @Intro(title: "Magic Keyboard와 손가락을 함께 추적하기") {
        visionOS 27에서 Apple Magic Keyboard Reference Object를 로드하고, Object Tracking과 Hand Tracking을 한 ARKitSession에서 실행합니다. ObjectAnchor의 생명 주기를 RealityKit Entity에 연결하고, 화면에 그리는 콘텐츠에는 rendered pose를 사용하는 이유까지 차례대로 살펴봅니다.
    }

    @Section(title: "Reference Object를 준비하고 세션 시작하기") {
        @ContentAndMedia {
            ARKit은 실물의 이름만으로 물체를 찾지 않습니다. 앱이 먼저 `.referenceobject` 파일을 `ReferenceObject`로 로드하고, 그 값을 `ObjectTrackingProvider`에 전달해야 합니다. 이 장에서는 Apple 공식 샘플의 Reference Object와 대응하는 Magic Keyboard 하나를 테이블 위에 고정해 사용합니다.

            완성 앱은 Xcode가 `ReferenceObjects` 폴더를 보존한 경우와 앱 번들 루트로 파일을 평탄화한 경우를 모두 지원합니다. 이 덕분에 XcodeGen으로 프로젝트를 다시 만들거나 Xcode에서 파일을 직접 추가해도 같은 로딩 코드가 동작합니다.

            @Image(source: "magic-keyboard-reference-installation.png", alt: "Magic Keyboard 외형에서 Reference Object 파일을 만들고 프로젝트 리소스로 설치한 뒤 검증하는 흐름의 개념 이미지")
        }

        @Steps {
            @Step {
                번들의 `ReferenceObjects` 하위 폴더와 루트에서 `.referenceobject` URL을 모으고 중복을 제거합니다. 각 URL은 visionOS 27의 `ReferenceObject(from:configuration:)`으로 비동기 로드합니다. 정지된 키보드이므로 기본 저프레임 설정을 유지하고, 하나라도 로드에 실패하면 오류를 호출자에게 전달합니다.

                @Code(name: "DrumAppModel.swift", file: "H-T02-S01-P01-DrumAppModel-final.swift", previousFile: "H-T02-S01-P01-DrumAppModel-before.swift")
            }
            @Step {
                `ObjectTrackingProvider.isSupported`와 `HandTrackingProvider.isSupported`를 확인한 뒤 Magic Keyboard Reference Object가 로드되었는지 검사합니다. 이 앱은 별도로 `requestAuthorization(for:)`을 호출하지 않으므로 `session.run(_:)` 시점에 두 Provider가 요구하는 권한을 암시적으로 요청합니다. 이전 장에서 추가한 World Sensing capability와 손 추적·주변 공간 사용 설명이 이 요청에 사용되며, 거부나 취소는 오류 메시지로 전환됩니다.

                @Code(name: "DrumAppModel.swift", file: "H-T02-S01-P02-DrumAppModel-final.swift", previousFile: "H-T02-S01-P02-DrumAppModel-before.swift")
            }
            @Step {
                사용할 Reference Object가 확인된 다음 `ARKitSession`, `ObjectTrackingProvider`, `HandTrackingProvider`를 생성합니다. 두 Provider를 같은 `session.run([objectProvider, handTracking])` 호출에 전달하고, ObjectAnchor, HandAnchor와 `session.events`의 세 비동기 sequence를 동시에 소비합니다. 실행 ID와 취소 상태를 확인해 종료된 세션의 update가 새 세션에 섞이지 않게 합니다.

                @Code(name: "DrumAppModel.swift", file: "H-T02-S01-P03-DrumAppModel-final.swift", previousFile: "H-T02-S01-P03-DrumAppModel-before.swift")
            }
        }
    }

    @Section(title: "ObjectAnchor의 생명 주기를 Entity에 연결하기") {
        @ContentAndMedia {
            `ObjectTrackingProvider.anchorUpdates`는 물체를 처음 찾으면 `.added`, 같은 물체의 자세나 추적 상태가 바뀌면 `.updated`, 더 이상 유지할 수 없으면 `.removed`를 보냅니다. 세 이벤트에서 같은 `anchor.id`를 키로 사용해야 한 실물과 한 RealityKit Entity의 관계가 유지됩니다.

            @Image(source: "object-tracking-recovery.png", alt: "Magic Keyboard가 정상 추적되고 가림으로 일시 중단된 뒤 같은 위치에서 다시 추적되는 세 단계의 개념 이미지")
        }

        @Steps {
            @Step {
                `.added`에서는 같은 ID의 오래된 Entity를 먼저 정리하고 `TrackedDrum(anchor:)`을 만듭니다. 새 인스턴스를 딕셔너리에 저장한 뒤 RealityView의 루트 Entity에 추가합니다.

                @Code(name: "DrumAppModel.swift", file: "H-T02-S02-P01-DrumAppModel-final.swift", previousFile: "H-T02-S02-P01-DrumAppModel-before.swift")
            }
            @Step {
                `.updated`가 전달되면 기존 `TrackedDrum`에 최신 anchor를 넘깁니다. `isTracked`가 `false`인 동안 Entity를 숨기고, 다시 추적되면 보이게 하며, 최신 pose로 transform을 갱신합니다.

                @Code(name: "TrackedDrum.swift", file: "H-T02-S02-P02-TrackedDrum-final.swift", previousFile: "H-T02-S02-P02-TrackedDrum-before.swift")
            }
            @Step {
                `.removed`에서는 딕셔너리에서 `TrackedDrum`을 꺼내는 동시에 Entity를 RealityKit 계층에서 제거합니다. 이벤트 처리 뒤에는 `isTracked`가 `true`인 개수와 Magic Keyboard 인식 상태를 화면용 모델 상태에 반영합니다.

                @Code(name: "DrumAppModel.swift", file: "H-T02-S02-P03-DrumAppModel-final.swift", previousFile: "H-T02-S02-P03-DrumAppModel-before.swift")
            }
        }
    }

    @Section(title: "rendered pose에 콘텐츠를 붙이고 프로필 선택하기") {
        @ContentAndMedia {
            visionOS 27의 ObjectAnchor pose에는 화면 표시를 위한 rendered correction이 적용된 좌표와 물리 측정을 위한 metric 좌표가 있습니다. 사람에게 보이는 가상 타격면은 실물 키보드에 안정적으로 붙어 있어야 하므로 이 앱은 기본 rendered pose인 `originFromAnchorTransform`으로 Entity transform을 설정합니다.

            Reference Object는 음색이나 표시 이름을 정하지 않습니다. 앱이 `anchor.referenceObject.name`을 정규화해 Magic Keyboard 프로필에 연결합니다.

            @Image(source: "spatial-object-drums-hero-v2.png", alt: "Magic Keyboard 위에 rendered pose로 고정된 가상 타격 영역을 양손 검지로 연주하는 목표 동작의 개념 이미지")
        }

        @Steps {
            @Step {
                `ObjectAnchor.boundingBox`에서 가로와 깊이를 얻어 4mm 높이의 초록색 상자를 만들고 키보드 윗면 바로 위에 놓습니다. 초기화와 update 모두 `originFromAnchorTransform`을 RealityKit `Transform`으로 변환하므로, 사용자가 머리를 움직일 때도 렌더링된 타격면이 키보드에 시각적으로 고정됩니다.

                @Code(name: "TrackedDrum.swift", file: "H-T02-S03-P01-TrackedDrum-final.swift", previousFile: "H-T02-S03-P01-TrackedDrum-before.swift")
            }
            @Step {
                참조 이름에서 공백, 밑줄, 하이픈을 제거하고 소문자로 바꾼 뒤 `magickeyboard`를 찾습니다. 일치하면 표시 이름을 **Apple Magic Keyboard**, 음원을 `wood-block.wav`로 선택합니다. 완성 파일에는 이름을 알 수 없는 Reference Object를 위한 일반 fallback도 남아 있지만 이 장의 기본 경로는 Magic Keyboard 하나입니다.

                @Code(name: "DrumProfile.swift", file: "H-T02-S03-P02-DrumProfile-final.swift", previousFile: "H-T02-S03-P02-DrumProfile-before.swift")
            }
        }
    }

    @Section(title: "visionOS 27 확장과 기본 동작 확인하기") {
        @ContentAndMedia {
            **이동 물체 확장 — high-frame-rate tracking**

            테이블 위에 정지한 Magic Keyboard는 기본 저프레임 추적으로 충분하고 전력·처리 비용도 더 낮습니다. 키보드를 손에 들고 움직이거나 빠르게 이동하는 도구를 추적하는 별도 기능을 만들 때만 `ReferenceObject.Configuration.highFrameRateTrackingEnabled`를 켜세요. 이 설정은 Reference Object를 로드할 때 적용하며, 높은 프레임률은 전력과 성능 비용을 크게 늘립니다.

            ```swift
            var configuration = ReferenceObject.Configuration()
            configuration.highFrameRateTrackingEnabled = true
            let movingObject = try await ReferenceObject(from: url, configuration: configuration)
            ```

            **측정 확장 — metric pose**

            Entity를 실물 위에 렌더링하는 기본 경로에서는 rendered pose를 유지합니다. 물체 사이의 실제 거리나 물리 좌표를 계산하는 별도 측정 기능에서만 display correction이 없는 `.none` 좌표 공간을 선택하세요. metric transform으로 화면용 Entity를 배치하면 rendered correction의 시각적 안정성을 잃을 수 있습니다.

            ```swift
            let metricSpace = anchor.coordinateSpace(correction: .none)
            let metricPosition = metricSpace.ancestorFromSpaceTransformFloat().translation
            ```

            @Image(source: "tracking-options-decision.png", alt: "정지한 Magic Keyboard의 기본 추적과 빠르게 움직이는 물체의 고주파 추적을 비교하는 개념 이미지")
        }

        @Steps {
            @Step {
                Apple 공식 Reference Object와 대응하는 Magic Keyboard를 밝고 복잡하지 않은 테이블 위에 움직이지 않게 놓고 앱에서 **Start Drumming**을 누릅니다. 손 추적과 주변 공간 접근 요청이 나타나면 허용합니다.

                @Image(source: "spatial-object-drums-hero-v2.png", alt: "Magic Keyboard 위 가상 타격 영역을 양손 검지로 연주하는 목표 동작의 개념 이미지")
            }
            @Step {
                여러 방향에서 키보드를 천천히 바라봅니다. 인식되면 키보드 위에 초록색 타격 영역과 **Apple Magic Keyboard 인식 완료** 안내가 나타나는지 확인합니다.

                @Image(source: "magic-keyboard-reference-installation.png", alt: "Magic Keyboard 외형에서 Reference Object 파일을 만들고 프로젝트 리소스로 설치한 뒤 검증하는 흐름의 개념 이미지")
            }
            @Step {
                키보드를 시야에서 잠시 가렸다가 다시 보여 줍니다. 추적이 끊긴 동안 Entity가 숨겨지고 다시 인식되면 같은 위치에 돌아오는지 확인합니다.

                @Image(source: "object-tracking-recovery.png", alt: "Magic Keyboard가 정상 추적되고 가림으로 일시 중단된 뒤 같은 위치에서 다시 추적되는 세 단계의 개념 이미지")
            }
        }
    }
}
