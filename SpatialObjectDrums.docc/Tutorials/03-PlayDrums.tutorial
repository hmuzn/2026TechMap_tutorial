@Tutorial(time: 45) {
    @Intro(title: "타격을 판정하고 공간 음향 재생하기") {
        검지 끝의 이동을 물체 좌표계에서 검사하고, 윗면을 아래 방향으로 통과했을 때 물체 위치에서 모노 타격음을 재생합니다.
    }

    @Section(title: "검지 끝의 월드 좌표 계산") {
        @ContentAndMedia {
            손 관절 transform은 손 Anchor를 기준으로 표현됩니다. `originFromAnchorTransform`과 `anchorFromJointTransform`을 곱하면 RealityKit 장면과 비교할 수 있는 월드 좌표가 됩니다.
        }

        @Steps {
            @Step {
                각 HandAnchor가 추적 중인지 확인하고 `indexFingerTip` joint를 가져옵니다.
            }
            @Step {
                두 transform을 곱한 행렬의 네 번째 열에서 검지 끝의 월드 위치를 얻습니다.
            }
            @Step {
                왼손과 오른손의 직전 위치를 chirality별로 저장합니다. 첫 프레임은 비교할 위치가 없으므로 판정하지 않습니다.

                @Code(name: "DrumAppModel.swift", file: "DrumAppModel.swift")
            }
        }
    }

    @Section(title: "물체 윗면 통과를 타격으로 판정") {
        @ContentAndMedia {
            물체가 회전해 있어도 동일한 규칙을 적용하려면 손가락의 월드 좌표를 물체 로컬 좌표로 변환해야 합니다. 직전 점은 윗면보다 위에 있고 현재 점은 윗면 이하이며, 현재 XZ 좌표가 바운딩 박스 안에 있을 때만 타격입니다.
        }

        @Steps {
            @Step {
                Entity의 월드 transform에 역행렬을 적용해 직전·현재 검지 위치를 물체 로컬 좌표로 바꿉니다.
            }
            @Step {
                Y 좌표가 `boundingBox.max.y`를 위에서 아래로 통과했는지 검사합니다.
            }
            @Step {
                현재 X와 Z가 바운딩 박스 안에 있는지 확인하고, 프레임 사이의 하강 거리를 0.15~1.0 강도로 정규화합니다.

                @Code(name: "TrackedDrum.swift", file: "TrackedDrum.swift")
            }
            @Step {
                물체별 마지막 타격 시각을 기록하고 100ms 안에 발생한 중복 타격을 무시합니다.
            }
        }
    }

    @Section(title: "공간 음향과 시각 피드백") {
        @ContentAndMedia {
            공간 음향은 소리를 재생한 Entity의 위치를 따라갑니다. 원치 않는 채널 혼합을 피하려면 짧은 모노 WAV 파일을 사용하세요.
        }

        @Steps {
            @Step {
                `wood-block.wav`, `tom.wav`, `percussion-fx.wav`를 Audio 리소스 폴더에 넣고 Target Membership을 켭니다.
            }
            @Step {
                `AudioFileResource`를 비동기로 로드하고 추적 Entity에 `SpatialAudioComponent`를 설정합니다.
            }
            @Step {
                타격 강도를 -18dB에서 0dB 사이 gain으로 변환해 음량을 바꾸고 Entity에서 오디오를 재생합니다.
            }
            @Step {
                타격 순간 피드백 면의 불투명도를 높였다가 90ms 후 원래 값으로 되돌립니다.
            }
        }
    }

    @Section(title: "RealityView 연결과 최종 테스트") {
        @Steps {
            @Step {
                RealityView에 추적 Entity를 담을 루트를 추가하고 모델의 세션을 시작합니다. View가 사라지면 세션을 정리합니다.

                @Code(name: "DrumRealityView.swift", file: "DrumRealityView.swift")
            }
            @Step {
                앱을 실기기에서 실행하고 손가락을 물체 위 3~5cm에서 천천히 내립니다. 소리가 너무 쉽게 나면 타격 깊이와 debounce 값을 조정합니다.
            }
            @Step {
                왼손과 오른손, 회전된 물체, 잠시 가려진 물체를 각각 시험합니다. 소리가 물체 위치에서 들리고 한 번의 동작에 한 번만 재생되는지 확인합니다.
            }
            @Step {
                추적 실패, 리소스 누락, 권한 거부 상태에서도 앱이 종료되지 않고 안내 메시지를 보여주는지 확인합니다.
            }
        }
    }
}
