@Tutorial(time: 45) {
    @Intro(title: "Magic Keyboard를 공간 드럼으로 연주하기") {
        왼손과 오른손의 검지 끝을 추적하고, 고정된 Apple Magic Keyboard 위의 가상 타격면을 아래 방향으로 통과할 때 키보드 위치에서 Wood Block 공간 음향을 재생합니다.

        이 장에서는 검지 좌표를 시간 정보가 있는 연속 움직임으로 만들고, 키보드 로컬 좌표에서 타격을 판정한 뒤, 양손별 cooldown과 시각·청각 피드백을 연결합니다. 오래되거나 비정상적으로 큰 위치 변화는 버려 추적 복구 순간의 오타격을 막고, 마지막에는 RealityView가 열리고 닫힐 때 추적 상태와 실패 정보를 안전하게 정리합니다.
    }

    @Section(title: "검지 끝의 연속 움직임 만들기") {
        @ContentAndMedia {
            손 관절 transform은 HandAnchor를 기준으로 표현됩니다. `originFromAnchorTransform`과 `anchorFromJointTransform`을 곱해 RealityKit 장면과 같은 월드 좌표를 만들고, 왼손과 오른손의 직전 좌표를 따로 보관해야 한 프레임 사이의 하향 이동을 판정할 수 있습니다.

            @Image(source: "hand-strike-spatial-audio.png", alt: "검지가 가상 타격면을 위에서 아래로 통과하고 Magic Keyboard 위치에서 공간 음향이 퍼지는 개념 이미지")
        }

        @Steps {
            @Step {
                추적 중인 HandAnchor에서 `indexFingerTip` joint를 가져옵니다. 두 transform을 곱한 행렬의 네 번째 열을 검지 끝의 월드 위치로 사용하고, HandAnchor나 joint가 추적 중이 아닐 때는 타격 판정을 진행하지 않습니다.

                @Code(name: "DrumAppModel.swift", file: "H-T03-01-IndexTip-final.swift", previousFile: "H-T03-01-IndexTip-before.swift")
            }
            @Step {
                현재 위치를 `HandAnchor.Chirality`별로 저장하고 같은 손의 직전 위치와 비교합니다. 첫 좌표는 기준점으로만 저장합니다. 손 추적이 끊기면 해당 손의 이전 좌표를 즉시 버려, 손이 다시 보인 첫 프레임이 오래된 좌표와 연결되어 오타격을 만들지 않게 합니다.

                @Code(name: "DrumAppModel.swift", file: "H-T03-02-ChiralityHistory-final.swift", previousFile: "H-T03-02-ChiralityHistory-before.swift")
            }
        }
    }

    @Section(title: "키보드 로컬 좌표에서 타격 판정하기") {
        @ContentAndMedia {
            이 예제의 Magic Keyboard는 테이블 위에 움직이지 않게 둡니다. 키보드가 회전해 있어도 같은 규칙을 적용할 수 있도록 직전·현재 검지 좌표를 키보드 Entity의 로컬 좌표로 변환합니다.

            초록색 가상 타격면과 실제 판정에 같은 `hitPlaneY`를 사용합니다. 직전 점이 타격면보다 위에 있고 현재 점이 타격면 이하이며, 타격 순간의 XZ 좌표가 키보드 바운딩 박스 안에 있을 때만 유효한 타격입니다.

            @Image(source: "hand-strike-spatial-audio.png", alt: "검지가 가상 타격면을 위에서 아래로 통과하고 Magic Keyboard 위치에서 공간 음향이 퍼지는 개념 이미지")
        }

        @Steps {
            @Step {
                키보드 Entity의 월드 transform에 역행렬을 적용해 직전·현재 검지 위치를 키보드 로컬 좌표로 바꿉니다. 이 변환으로 키보드의 월드 위치와 회전에 관계없이 바운딩 박스 기준으로 비교할 수 있습니다.

                @Code(name: "TrackedDrum.swift", file: "H-T03-03-KeyboardLocal-final.swift", previousFile: "H-T03-03-KeyboardLocal-before.swift")
            }
            @Step {
                `boundingBox.max.y` 바로 위에 하나의 `hitPlaneY`를 정하고, 초록색 피드백 면과 하향 통과 판정이 모두 이 높이를 사용하게 합니다. 두 샘플 사이 선분이 타격면과 만나는 XZ 좌표를 보간해 바운딩 박스 안인지 확인합니다. 샘플 간 시간으로 하강 속도를 계산해 프레임 속도 변화에도 일관된 강도를 만들며, 오래된 샘플과 순간이동에 가까운 큰 변화는 무시합니다.

                @Code(name: "TrackedDrum.swift", file: "H-T03-04-HitPlane-final.swift", previousFile: "H-T03-04-HitPlane-before.swift")
            }
            @Step {
                유효한 타격 뒤에는 ObjectAnchor ID와 손의 chirality 조합별 마지막 타격 시각을 기록합니다. 같은 손의 짧은 중복 판정은 무시하지만 반대 손의 교대 타격은 막지 않습니다. 기본 100ms 값은 앱의 연주 감도 설정에서 조절할 수 있습니다.

                @Code(name: "DrumAppModel.swift", file: "H-T03-05-Cooldown-final.swift", previousFile: "H-T03-05-Cooldown-before.swift")
            }
        }
    }

    @Section(title: "공간 음향과 opacity 피드백 연결하기") {
        @ContentAndMedia {
            `wood-block.wav`는 짧은 모노 파일로 앱 Target에 포함합니다. 오디오는 추적 Entity에서 재생되므로 소리가 Magic Keyboard의 Reference Object 원점에서 들립니다. 파일을 읽지 못하면 타격을 조용히 무시하지 않고 상위 모델에 오류를 전달해 화면에 원인을 표시합니다.

            @Image(source: "hand-strike-spatial-audio.png", alt: "검지가 가상 타격면을 위에서 아래로 통과하고 Magic Keyboard 위치에서 공간 음향이 퍼지는 개념 이미지")
        }

        @Steps {
            @Step {
                `wood-block.wav`를 `AudioFileResource`로 비동기 로드하고 키보드 Entity에 `SpatialAudioComponent`를 설정합니다. 유효 intensity 0.15~1.0을 다시 0~1로 정규화한 뒤 gain -18~0dB에 선형으로 매핑해, 가장 약한 유효 타격도 -18dB에서 시작하게 합니다.

                @Code(name: "TrackedDrum.swift", file: "H-T03-06-SpatialAudio-final.swift", previousFile: "H-T03-06-SpatialAudio-before.swift")
            }
            @Step {
                opacity는 한 가지 경로로만 제어합니다. 평소 초록색 타격면은 0.42, 타격 순간은 0.9로 표시하고, 90ms 후 정확히 0.42로 되돌립니다. 새 타격이 들어오면 이전 복귀 작업을 취소해 연타 중 피드백이 먼저 꺼지는 경쟁 상태를 막습니다.

                @Code(name: "TrackedDrum.swift", file: "H-T03-07-OpacityFeedback-final.swift", previousFile: "H-T03-07-OpacityFeedback-before.swift")
            }
        }
    }

    @Section(title: "RealityView 생명주기와 실패 처리하기") {
        @ContentAndMedia {
            ARKitSession은 Mixed Immersive Space가 보이는 동안에만 실행합니다. 공간을 닫은 뒤 남아 있는 Provider update나 손가락 이력이 다음 실행에 섞이지 않아야 합니다.

            @Image(source: "tracking-session-lifecycle-v2.png", alt: "하나의 ARKit 세션에서 Magic Keyboard와 양손을 함께 추적해 타격면으로 연결하고 종료 시 초기화하는 흐름의 개념 이미지")
        }

        @Steps {
            @Step {
                `@State`로 유지되는 루트 Entity를 RealityView에 한 번 추가하고 `.task`에서 모델의 세션을 시작합니다. View가 사라지면 Session과 Provider를 멈추고, 추적 Entity, cooldown 시각, 양손의 이전 좌표와 Immersive Space 상태를 모두 정리합니다.

                @Code(name: "DrumRealityView.swift", file: "H-T03-08-RealityLifecycle-final.swift", previousFile: "H-T03-08-RealityLifecycle-before.swift")
            }
            @Step {
                Reference Object 또는 `wood-block.wav` 로드 실패와 지원되지 않는 Provider는 시작 경로의 `do-catch`에서 처리합니다. 실행 중에는 `ARKitSession.events`의 `authorizationChanged`와 `dataProviderStateChanged`를 계속 관찰합니다. 필수 권한이 `.denied`로 바뀌거나 Provider가 예기치 않게 `.stopped`가 되면 추적 Entity와 손 좌표를 정리하고 원인을 화면에 표시합니다. 앱은 종료하지 않고, 공간을 닫았다가 다시 시작할 수 있는 상태를 유지합니다.

                @Code(name: "DrumAppModel.swift", file: "H-T03-09-FailureHandling-final.swift", previousFile: "H-T03-09-FailureHandling-before.swift")
            }
        }
    }

    @Section(title: "Magic Keyboard에서 최종 검증하기") {
        @ContentAndMedia {
            Apple Vision Pro 실기기에서 Apple 공식 Reference Object와 대응하는 Magic Keyboard를 움직이지 않게 놓고 아래 순서로 확인합니다. 각 단계가 실패하면 다음 단계로 넘어가기 전에 해당 장의 코드와 상태 메시지를 다시 확인하세요.

            @Image(source: "spatial-object-drums-hero-v2.png", alt: "Magic Keyboard 위 가상 타격 영역을 양손 검지로 연주하는 목표 동작의 개념 이미지")
        }

        @Steps {
            @Step {
                **Start Drumming**을 누르고 손 추적과 주변 공간 접근을 허용합니다. 키보드를 찾으면 키캡 바로 위에 초록색 타격면이 나타나는지 확인합니다.

                @Image(source: "spatial-object-drums-hero-v2.png", alt: "Magic Keyboard 위 가상 타격 영역을 양손 검지로 연주하는 목표 동작의 개념 이미지")
            }
            @Step {
                왼손과 오른손 검지를 각각 타격면 위에서 아래로 통과시킵니다. 한 동작마다 Wood Block 소리가 한 번만 키보드 위치에서 들려야 합니다.

                @Image(source: "hand-strike-spatial-audio.png", alt: "검지가 가상 타격면을 위에서 아래로 통과하고 Magic Keyboard 위치에서 공간 음향이 퍼지는 개념 이미지")
            }
            @Step {
                손을 잠시 가렸다가 타격면 아래에서 다시 보이게 합니다. 재인식 첫 프레임에서는 소리가 나지 않아야 합니다.

                @Image(source: "object-tracking-recovery.png", alt: "Magic Keyboard가 정상 추적되고 가림으로 일시 중단된 뒤 같은 위치에서 다시 추적되는 세 단계의 개념 이미지")
            }
            @Step {
                약한 타격과 강한 타격의 음량 차이, 같은 손의 짧은 중복 방지, 양손 교대 연주, `0.42 → 0.9 → 0.42` opacity 복귀를 확인합니다. 필요하면 창의 연주 감도 설정을 바꿔 같은 조건에서 다시 측정합니다.

                @Image(source: "hand-strike-spatial-audio.png", alt: "검지가 가상 타격면을 위에서 아래로 통과하고 Magic Keyboard 위치에서 공간 음향이 퍼지는 개념 이미지")
            }
            @Step {
                `wood-block.wav` 누락, 첫 권한 요청 거부와 실행 중 설정에서 권한 회수를 각각 시험합니다. 앱이 종료되거나 조용히 실패하지 않고 추적 콘텐츠를 정리한 뒤 원인을 설명하는 오류 메시지를 보여야 합니다.

                @Image(source: "object-tracking-recovery.png", alt: "Magic Keyboard가 정상 추적되고 가림으로 일시 중단된 뒤 같은 위치에서 다시 추적되는 세 단계의 개념 이미지")
            }
            @Step {
                **Stop Drumming**으로 공간을 닫고 다시 시작합니다. 이전 Entity, cooldown, 손 좌표가 남아 있지 않고 키보드를 새로 인식해야 합니다.

                @Image(source: "tracking-session-lifecycle-v2.png", alt: "하나의 ARKit 세션에서 Magic Keyboard와 양손을 함께 추적해 타격면으로 연결하고 종료 시 초기화하는 흐름의 개념 이미지")
            }
        }
    }
}
